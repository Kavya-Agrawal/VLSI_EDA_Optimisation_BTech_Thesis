# ABC build outputs
abc/abc
abc/abc.exe
abc/*.o
abc/*.a

# Large third-party OpenROAD clones (root only).
# NOTE: bare "OpenROAD/" also matches ml_for_eda_research/openroad/ on
# Windows (case-insensitive), so keep the negation below.
/OpenROAD/
openroad_repos/
!ml_for_eda_research/openroad/
!ml_for_eda_research/openroad/**
