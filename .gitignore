# Keep in-repo model source trees (PyTorch packages named models/)
!abc/src/ext_ml/python/models/
!abc/src/ext_ml/python/models/**
!abc/src/ext_poly/python/models/
!abc/src/ext_poly/python/models/**
!openroad_ml/**/models/
!openroad_ml/**/models/**

# Large macro-placement datasets (clone separately if needed)
macroPlace/macro-place-challenge-2026/external/MacroPlacement/Testcases/
macroPlace/macro-place-challenge-2026/external/MacroPlacement/ExperimentalData/
macroPlace/macro-place-challenge-2026/external/MacroPlacement/Flows/
macroPlace/macro-place-challenge-2026/benchmarks/raw/
macroPlace/macro-place-challenge-2026/results/
macroPlace/Macro_Placement_ML_for_EDA/dataset/

# Allow selected processed benchmarks
!macroPlace/macro-place-challenge-2026/benchmarks/processed/
!macroPlace/macro-place-challenge-2026/benchmarks/processed/public/
