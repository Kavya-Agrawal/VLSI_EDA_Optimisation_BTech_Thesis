+// SPDX-License-Identifier: BSD-3-Clause
+#include <algorithm>
+#include <cstddef>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace ord::learning {
+struct SlackSummary
+{
+  double worst = std::numeric_limits<double>::infinity();
+  double negative_sum = 0;
+  std::size_t count = 0;
+};
+
+inline SlackSummary merge(const SlackSummary& a, const SlackSummary& b)
+{
+  return {std::min(a.worst, b.worst), a.negative_sum + b.negative_sum,
+          a.count + b.count};
+}
+
+// Associative aggregate supports WNS and TNS from the same indexed tree.
+class SlackTree
+{
+ public:
+  explicit SlackTree(const std::vector<double>& slacks) : count_(slacks.size())
+  {
+    while (size_ < count_) {
+      size_ *= 2;
+    }
+    tree_.resize(2 * size_);
+    for (std::size_t i = 0; i < count_; ++i) {
+      tree_[size_ + i] = leaf(slacks[i]);
+    }
+    for (auto i = size_; i-- > 1;) {
+      tree_[i] = merge(tree_[2 * i], tree_[2 * i + 1]);
+    }
+  }
+
+  void update(std::size_t index, double slack)
+  {
+    if (index >= count_) {
+      throw std::out_of_range("SlackTree point index");
+    }
+    index += size_;
+    tree_[index] = leaf(slack);
+    while (index > 1) {
+      index /= 2;
+      tree_[index] = merge(tree_[2 * index], tree_[2 * index + 1]);
+    }
+  }
+
+  SlackSummary query(std::size_t begin, std::size_t end) const
+  {
+    if (begin > end || end > count_) {
+      throw std::out_of_range("SlackTree query range");
+    }
+    SlackSummary left, right;
+    for (begin += size_, end += size_; begin < end; begin /= 2, end /= 2) {
+      if (begin & 1) {
+        left = merge(left, tree_[begin++]);
+      }
+      if (end & 1) {
+        right = merge(tree_[--end], right);
+      }
+    }
+    return merge(left, right);
+  }
+
+ private:
+  static SlackSummary leaf(double slack)
+  {
+    return {slack, std::min(0.0, slack), 1};
+  }
+  std::size_t count_;
+  std::size_t size_ = 1;
+  std::vector<SlackSummary> tree_;
+};
+}  // namespace ord::learning
+// END INTEGRATED KERNEL SlackTree
