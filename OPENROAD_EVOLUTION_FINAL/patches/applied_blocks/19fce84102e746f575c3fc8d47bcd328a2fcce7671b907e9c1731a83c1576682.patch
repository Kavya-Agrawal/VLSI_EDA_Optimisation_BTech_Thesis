+namespace ord::learning {
+// Zero-based public indices; half-open prefix/range conventions.
+class Fenwick
+{
+ public:
+  explicit Fenwick(std::size_t size) : tree_(size + 1, 0.0) {}
+  std::size_t size() const { return tree_.size() - 1; }
+
+  void add(std::size_t index, double delta)
+  {
+    if (index >= size()) {
+      throw std::out_of_range("Fenwick point index");
+    }
+    for (++index; index < tree_.size(); index += index & -index) {
+      tree_[index] += delta;
+    }
+  }
+
+  double prefix(std::size_t end) const
+  {
+    if (end > size()) {
+      throw std::out_of_range("Fenwick prefix end");
+    }
+    double value = 0;
+    for (; end > 0; end -= end & -end) {
+      value += tree_[end];
+    }
+    return value;
+  }
+
+  double range(std::size_t begin, std::size_t end) const
+  {
+    if (begin > end) {
+      throw std::invalid_argument("Fenwick reversed range");
+    }
+    return prefix(end) - prefix(begin);
+  }
+
+  // First zero-based index whose inclusive prefix reaches target.
+  // All point values must be nonnegative for this selection operation.
+  std::size_t select(double target) const
+  {
+    if (target <= 0) {
+      return 0;
+    }
+    std::size_t index = 0;
+    std::size_t step = 1;
+    while (step <= size() / 2) {
+      step *= 2;
+    }
+    for (; step > 0; step /= 2) {
+      const auto next = index + step;
+      if (next <= size() && tree_[next] < target) {
+        target -= tree_[next];
+        index = next;
+      }
+    }
+    return index;  // size() is the sentinel when target exceeds total.
+  }
+
+ private:
+  std::vector<double> tree_;
+};
+}  // namespace ord::learning
+// END INTEGRATED KERNEL Fenwick
