+// SPDX-License-Identifier: BSD-3-Clause
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+namespace ord::learning {
+struct BudgetItem
+{
+  std::size_t id;
+  unsigned cost;
+  double benefit;
+};
+struct BudgetSelection
+{
+  double benefit = 0;
+  unsigned cost = 0;
+  std::vector<std::size_t> ids;
+};
+
+inline BudgetSelection budgetDp(const std::vector<BudgetItem>& items, unsigned budget)
+{
+  struct Link
+  {
+    std::size_t id;
+    std::shared_ptr<const Link> previous;
+  };
+  struct State
+  {
+    double benefit = 0;
+    unsigned cost = 0;
+    std::shared_ptr<const Link> tail;
+  };
+  std::vector<State> states(budget + 1);
+  for (const auto& item : items) {
+    if (!item.cost || !std::isfinite(item.benefit)) {
+      throw std::invalid_argument("DP needs positive cost and finite benefit");
+    }
+    if (item.cost > budget || item.benefit <= 0) {
+      continue;
+    }
+    for (unsigned capacity = budget; capacity >= item.cost; --capacity) {
+      const State previous = states[capacity - item.cost];
+      const double proposal = previous.benefit + item.benefit;
+      if (proposal > states[capacity].benefit) {
+        states[capacity] = {proposal, previous.cost + item.cost,
+                           std::make_shared<Link>(Link{item.id, previous.tail})};
+      }
+    }
+  }
+  BudgetSelection result{states[budget].benefit, states[budget].cost, {}};
+  for (auto link = states[budget].tail; link; link = link->previous) {
+    result.ids.push_back(link->id);
+  }
+  std::reverse(result.ids.begin(), result.ids.end());
+  return result;
+}
+
+inline BudgetSelection budgetGreedy(std::vector<BudgetItem> items, unsigned budget)
+{
+  for (const auto& item : items) {
+    if (!item.cost || !std::isfinite(item.benefit)) {
+      throw std::invalid_argument("Greedy needs positive cost and finite benefit");
+    }
+  }
+  std::stable_sort(items.begin(), items.end(), [](const auto& a, const auto& b) {
+    return a.benefit / a.cost > b.benefit / b.cost;
+  });
+  BudgetSelection result;
+  for (const auto& item : items) {
+    if (item.benefit > 0 && item.cost <= budget - result.cost) {
+      result.ids.push_back(item.id);
+      result.cost += item.cost;
+      result.benefit += item.benefit;
+    }
+  }
+  return result;
+}
+}  // namespace ord::learning
+// END INTEGRATED KERNEL BudgetDp
