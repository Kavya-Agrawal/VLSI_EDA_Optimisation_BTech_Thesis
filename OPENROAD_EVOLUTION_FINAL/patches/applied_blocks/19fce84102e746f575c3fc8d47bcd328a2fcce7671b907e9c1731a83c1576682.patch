+// BEGIN INTEGRATED KERNEL RepairOrder
+// SPDX-License-Identifier: BSD-3-Clause
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <numeric>
+#include <string_view>
+
+namespace ord::learning {
+struct RepairFeature
+{
+  std::size_t original;
+  double normalized_load;
+  double prefix_pressure;
+  double neighborhood_peak;
+  double score;
+};
+
+inline std::vector<RepairFeature> extractRepairFeatures(
+    const std::vector<double>& loads, const PolicyConfig& config)
+{
+  double scale = 0;
+  for (double load : loads) {
+    if (!std::isfinite(load)) {
+      throw std::invalid_argument("Nonfinite path-driver load");
+    }
+    scale = std::max(scale, std::abs(load));
+  }
+  scale = std::max(scale, 1e-30);
+  Fenwick prefix(loads.size());
+  std::vector<double> negative_load;
+  for (std::size_t i = 0; i < loads.size(); ++i) {
+    const double normalized = std::max(0.0, loads[i] / scale);
+    prefix.add(i, normalized);
+    negative_load.push_back(-normalized);
+  }
+  SlackTree tree(negative_load);
+  std::vector<RepairFeature> result;
+  for (std::size_t i = 0; i < loads.size(); ++i) {
+    const auto left = i > config.neighborhood ? i - config.neighborhood : 0;
+    const auto right = std::min(loads.size(), i + config.neighborhood + 1);
+    const double normalized = -negative_load[i];
+    const double accumulated = prefix.prefix(i + 1) / (i + 1);
+    const double peak = -tree.query(left, right).worst;
+    const double position = loads.size() > 1 ? double(i) / (loads.size() - 1) : 0;
+    const double density = prefix.range(left, right) / (right - left);
+    const double score = config.load_weight * normalized
+                         + config.prefix_weight * accumulated
+                         + config.neighborhood_weight * peak
+                         + config.density_weight * density
+                         + config.late_weight * position
+                         + config.critical_weight * normalized * normalized;
+    result.push_back({i, normalized, accumulated, peak, score});
+  }
+  return result;
+}
+
+inline std::vector<std::size_t> repairOrder(const std::vector<double>& loads,
+                                           PolicyConfig config = policyConfig())
+{
+  const auto features = extractRepairFeatures(loads, config);
+  std::vector<BudgetItem> items;
+  for (const auto& feature : features) {
+    // Cost is a bounded illustrative repair-effort estimate, not cell area.
+    const auto cost = 1u + static_cast<unsigned>(3 * feature.normalized_load);
+    items.push_back({feature.original, cost, feature.score});
+  }
+  const auto selected = config.use_dp ? budgetDp(items, config.budget)
+                                      : budgetGreedy(items, config.budget);
+  std::vector<bool> preferred(loads.size(), false);
+  for (auto id : selected.ids) {
+    preferred[id] = true;
+  }
+  std::vector<std::size_t> order(loads.size());
+  std::iota(order.begin(), order.end(), 0);
+  std::stable_sort(order.begin(), order.end(), [&](auto a, auto b) {
+    if (preferred[a] != preferred[b]) {
+      return bool(preferred[a]);
+    }
+    if (features[a].score != features[b].score) {
+      return features[a].score > features[b].score;
+    }
+    return a < b;
+  });
+  return order;  // Every original target remains exactly once.
+}
+}  // namespace ord::learning
