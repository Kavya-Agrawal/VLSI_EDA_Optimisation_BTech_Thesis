--- a/learning_evolution/tests/Policies.cpp
+++ b/learning_evolution/tests/Policies.cpp
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "TestSupport.h"
+#include "learning/RepairOrder.h"
+#include <numeric>
+#include <random>
+
+namespace learning_test {
+void testPolicies()
+{
+  using namespace ord::learning;
+  std::mt19937 random(211);
+  for (unsigned count = 0; count < 100; ++count) {
+    std::vector<double> loads(count);
+    for (auto& load : loads) {
+      load = double(random() % 1000) / 10;
+    }
+    for (unsigned budget : {0u, 3u, 12u, 30u}) {
+      PolicyConfig config;
+      config.budget = budget;
+      for (bool dp : {false, true}) {
+        config.use_dp = dp;
+        const auto order = repairOrder(loads, config);
+        auto sorted = order;
+        std::sort(sorted.begin(), sorted.end());
+        CHECK(sorted.size() == loads.size());
+        for (std::size_t i = 0; i < sorted.size(); ++i) {
+          CHECK(sorted[i] == i);
+        }
+        CHECK(repairOrder(loads, config) == order);
+        for (const auto& feature : extractRepairFeatures(loads, config)) {
+          CHECK(std::isfinite(feature.score));
+          CHECK(feature.normalized_load >= 0);
+          CHECK(feature.normalized_load <= 1);
+        }
+      }
+    }
+  }
+  CHECK(repairOrder({0, 0, 0}).size() == 3);
+  CHECK(repairOrder({}).empty());
+  rejects([] { repairOrder({std::numeric_limits<double>::quiet_NaN()}); });
+  // Default-off integration is checked independently of kernel selection.
+  unsetenv("OPENROAD_LEARNING_EVOLUTION");
+  CHECK(!enabled());
+  setenv("OPENROAD_LEARNING_EVOLUTION", "1", 1);
+  CHECK(enabled());
+  setenv("OPENROAD_LEARNING_EVOLUTION", "0", 1);
+  CHECK(!enabled());
+  unsetenv("OPENROAD_LEARNING_EVOLUTION");
+}
+}  // namespace learning_test
