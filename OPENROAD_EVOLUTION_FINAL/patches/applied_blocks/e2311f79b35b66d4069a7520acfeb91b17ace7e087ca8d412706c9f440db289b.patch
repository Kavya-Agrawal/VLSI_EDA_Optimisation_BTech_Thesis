+  double end;
+  std::size_t id;
+};
+
+// Sorted interval index with subtree maximum endpoints for overlap pruning.
+class IntervalIndex
+{
+ public:
+  explicit IntervalIndex(std::vector<Interval> intervals) : intervals_(std::move(intervals))
+  {
+    for (const auto& interval : intervals_) {
+      if (!(interval.begin <= interval.end)) {
+        throw std::invalid_argument("Reversed interval");
+      }
+    }
+    std::stable_sort(intervals_.begin(), intervals_.end(), [](const auto& a, const auto& b) {
+      return a.begin < b.begin;
+    });
+    maxima_.resize(4 * intervals_.size() + 4, -std::numeric_limits<double>::infinity());
+    if (!intervals_.empty()) {
+      build(1, 0, intervals_.size());
+    }
+  }
+
+  std::vector<std::size_t> overlaps(double begin, double end) const
+  {
+    if (!(begin <= end)) {
+      throw std::invalid_argument("Reversed interval query");
+    }
+    std::vector<std::size_t> result;
+    if (!intervals_.empty()) {
+      query(1, 0, intervals_.size(), begin, end, result);
+    }
+    std::sort(result.begin(), result.end());
+    return result;
+  }
+
+ private:
+  double build(std::size_t node, std::size_t begin, std::size_t end)
+  {
+    if (end - begin == 1) {
+      return maxima_[node] = intervals_[begin].end;
+    }
+    const auto mid = begin + (end - begin) / 2;
+    const double left = build(node * 2, begin, mid);
+    const double right = build(node * 2 + 1, mid, end);
+    return maxima_[node] = std::max(left, right);
+  }
+
+  void query(std::size_t node, std::size_t begin, std::size_t end,
+             double low, double high, std::vector<std::size_t>& result) const
+  {
+    if (maxima_[node] < low || intervals_[begin].begin > high) {
+      return;
+    }
+    if (end - begin == 1) {
+      result.push_back(intervals_[begin].id);
+      return;
+    }
+    const auto mid = begin + (end - begin) / 2;
+    query(node * 2, begin, mid, low, high, result);
+    query(node * 2 + 1, mid, end, low, high, result);
+  }
+  std::vector<Interval> intervals_;
+  std::vector<double> maxima_;
+};
