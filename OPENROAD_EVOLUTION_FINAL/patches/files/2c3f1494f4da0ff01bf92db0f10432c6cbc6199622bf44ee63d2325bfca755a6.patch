+namespace ord::learning {
+struct Objective
+{
+  std::size_t id;
+  // All components are costs: slack loss, area, runtime, for example.
+  std::array<double, 3> costs;
+};
+
+inline bool dominates(const Objective& a, const Objective& b)
+{
+  bool strict = false;
+  for (std::size_t i = 0; i < a.costs.size(); ++i) {
+    if (a.costs[i] > b.costs[i]) {
+      return false;
+    }
+    strict = strict || a.costs[i] < b.costs[i];
+  }
+  return strict;
+}
+
+inline std::vector<Objective> paretoFront(const std::vector<Objective>& candidates)
+{
+  for (const auto& candidate : candidates) {
+    for (double cost : candidate.costs) {
+      if (!std::isfinite(cost)) {
+        throw std::invalid_argument("Nonfinite Pareto objective");
+      }
+    }
+  }
+  std::vector<Objective> front;
+  for (std::size_t i = 0; i < candidates.size(); ++i) {
+    bool dominated = false;
+    for (std::size_t j = 0; j < candidates.size(); ++j) {
+      if (i != j && dominates(candidates[j], candidates[i])) {
+        dominated = true;
+        break;
+      }
+    }
+    if (!dominated) {
+      front.push_back(candidates[i]);
+    }
+  }
+  return front;
+}
+
+inline std::vector<std::vector<Objective>> nondominatedLayers(std::vector<Objective> remaining)
+{
+  std::vector<std::vector<Objective>> layers;
+  while (!remaining.empty()) {
+    auto front = paretoFront(remaining);
+    std::vector<Objective> next;
+    for (const auto& candidate : remaining) {
+      const bool on_front = std::any_of(front.begin(), front.end(), [&](const auto& member) {
+        return member.id == candidate.id;
+      });
+      if (!on_front) {
+        next.push_back(candidate);
+      }
+    }
+    layers.push_back(std::move(front));
+    remaining = std::move(next);
+  }
+  return layers;
+}
+}  // namespace ord::learning
+// END INTEGRATED KERNEL Pareto
