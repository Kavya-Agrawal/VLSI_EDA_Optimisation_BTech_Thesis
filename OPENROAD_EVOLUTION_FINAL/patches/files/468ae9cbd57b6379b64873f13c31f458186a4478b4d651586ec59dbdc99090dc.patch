--- a/learning_evolution/tests/Graph.cpp
+++ b/learning_evolution/tests/Graph.cpp
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "TestSupport.h"
+#include "learning/DisjointSet.h"
+#include "learning/MinCostFlow.h"
+#include "learning/SpanningTree.h"
+#include "learning/TimingDag.h"
+#include <random>
+
+namespace learning_test {
+void testGraph()
+{
+  using namespace ord::learning;
+  DisjointSet sets(6);
+  CHECK(sets.components() == 6);
+  CHECK(sets.unite(0, 1));
+  CHECK(sets.unite(1, 2));
+  CHECK(!sets.unite(2, 0));
+  CHECK(sets.componentSize(0) == 3);
+  CHECK(sets.components() == 4);
+  rejects([&] { sets.find(6); });
+  TimingDag graph({2, 3, 4, 1});
+  graph.addEdge(0, 1);
+  graph.addEdge(0, 2);
+  graph.addEdge(1, 3);
+  graph.addEdge(2, 3);
+  rejects([&] { graph.arrivals(); });
+  graph.compile();
+  CHECK(graph.arrivals() == std::vector<double>({2, 5, 6, 7}));
+  CHECK(graph.required(6) == std::vector<double>({1, 5, 5, 6}));
+  CHECK(graph.slacks(6) == std::vector<double>({-1, 0, -1, -1}));
+  CHECK(graph.affected(1) == std::vector<std::size_t>({1, 3}));
+  graph.setDelay(2, 2);
+  CHECK(graph.arrivals().back() == 6);
+  graph.addEdge(3, 0);
+  rejects([&] { graph.compile(); });
+  rejects([] { TimingDag({-1}); });
+  MinCostFlow flow(6);
+  flow.addEdge(0, 1, 1, 0);
+  flow.addEdge(0, 2, 1, 0);
+  flow.addEdge(1, 3, 1, 1);
+  flow.addEdge(1, 4, 1, 3);
+  flow.addEdge(2, 3, 1, 2);
+  flow.addEdge(2, 4, 1, 8);
+  flow.addEdge(3, 5, 1, 0);
+  flow.addEdge(4, 5, 1, 0);
+  const auto assignment = flow.solve(0, 5, 2);
+  CHECK(assignment.first == 2);
+  CHECK(near(assignment.second, 5)); // Reverse edges repair the first assignment.
+  CHECK(flow.solve(0, 5, 1).first == 0);
+  rejects([&] { flow.addEdge(0, 0, 1, 0); });
+  const std::vector<Point> square{{0, 0, 0}, {0, 1, 1}, {1, 0, 2}, {1, 1, 3}};
+  const auto tree = denseManhattanTree(square);
+  CHECK(tree.size() == 3);
+  double weight = 0;
+  for (const auto& edge : tree) {
+    weight += edge.weight;
+  }
+  CHECK(weight == 3);
+  CHECK(preorderTour(4, tree).size() == 4);
+  rejects([] { preorderTour(3, {{0, 1, 1}}); });
+  CHECK(kruskal(3, {{0, 1, 2}}).size() == 1);
+  rejects([] { kruskal(2, {{0, 2, 1}}); });
+  // Differential longest-path oracle on randomly generated forward DAGs.
+  std::mt19937 random(91);
+  for (unsigned trial = 0; trial < 100; ++trial) {
+    std::vector<double> delays(12);
+    for (auto& delay : delays) {
+      delay = random() % 7;
+    }
+    TimingDag dag(delays);
+    std::vector<double> expected = delays;
+    for (std::size_t to = 0; to < delays.size(); ++to) {
+      double incoming = 0;
+      for (std::size_t from = 0; from < to; ++from) {
+        if (random() % 3 == 0) {
+          dag.addEdge(from, to);
+          incoming = std::max(incoming, expected[from]);
+        }
+      }
+      expected[to] += incoming;
+    }
+    dag.compile();
+    CHECK(dag.arrivals() == expected);
+  }
+}
+}  // namespace learning_test
