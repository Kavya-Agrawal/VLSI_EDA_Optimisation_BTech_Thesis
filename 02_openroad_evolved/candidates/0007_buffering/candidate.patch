+
+    odb::Rect kept_box(origin, origin);
+    for (const auto& [vertex, headroom] : fanout_slacks) {
+      if (moved.find(vertex->pin()) == moved.end()) {
+        kept_box.merge(resizer.dbNetwork()->location(vertex->pin()));
+      }
+    }
