+          safe = false;
+        }
+        old_worst = std::min(old_worst, before);
+        new_worst = std::min(new_worst, after);
+        tns_gain += std::min(after, 0.0f) - std::min(before, 0.0f);
+      }
+    }
+    const float gain = new_worst - old_worst;
+    if (safe && std::isfinite(gain) && gain > 0.0f &&
