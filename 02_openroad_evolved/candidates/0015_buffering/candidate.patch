+    logger->report("RSZ_EVOLVE split_cutpoint_dropped fired={}",
+                   g_cutpoint_dropped);
+    g_cutpoint_reranked = 0;
+    g_cutpoint_candidates = 0;
+    g_cutpoint_dropped = 0;
+  }
 }
 
