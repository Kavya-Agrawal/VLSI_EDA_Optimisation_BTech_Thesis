+std::atomic<int64_t> g_evolve_root_evals{0};
+std::atomic<int64_t> g_evolve_multi_viol{0};
+std::atomic<int64_t> g_evolve_root_choice_changed{0};
+std::atomic<int64_t> g_evolve_tns_reduced{0};
