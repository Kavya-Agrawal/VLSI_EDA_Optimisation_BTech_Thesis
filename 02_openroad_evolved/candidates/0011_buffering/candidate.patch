+
+void Rebuffer::reportEvolveCounters(utl::Logger* logger)
+{
+  logger->report("RSZ_EVOLVE root_evals fired={}", g_evolve_root_evals.exchange(0));
+  logger->report("RSZ_EVOLVE multi_viol fired={}", g_evolve_multi_viol.exchange(0));
+  logger->report("RSZ_EVOLVE root_choice_changed fired={}",
+                 g_evolve_root_choice_changed.exchange(0));
+  logger->report("RSZ_EVOLVE tns_reduced fired={}", g_evolve_tns_reduced.exchange(0));
+}
+
+double Rebuffer::totalSinkViolation(const BufferedNetPtr& option,
+                                    const FixedDelay driver_correction,
+                                    int& violating_sinks)
+{
+  double total = 0.0;
+  violating_sinks = 0;
+  // Walk with the accumulated delay from the driver (negated into slack).
+  std::vector<std::pair<const BufferedNet*, FixedDelay>> stack;
+  stack.emplace_back(option.get(), driver_correction);
+  while (!stack.empty()) {
+    const auto [node, acc] = stack.back();
+    stack.pop_back();
+    switch (node->type()) {
+      case BnetType::junction:
+        stack.emplace_back(node->ref2().get(), acc);
+        stack.emplace_back(node->ref().get(), acc);
+        break;
+      case BnetType::load: {
+        if (node->slackTransition() == nullptr) {
+          break;  // unconstrained sink
+        }
+        const double slack = (node->slack() + acc).toSeconds();
+        if (slack < 0.0) {
+          total -= slack;
+          violating_sinks++;
+        }
+        break;
+      }
+      default:
+        stack.emplace_back(node->ref().get(), acc - node->delay());
+        break;
+    }
+  }
+  return total;
+}
+
+size_t Rebuffer::chooseLowestTnsOption(
+    const std::vector<RankedOption>& evaluated,
+    const size_t stock_best)
+{
+  g_evolve_root_evals++;
+  const RankedOption& best = evaluated[stock_best];
+  if (best.unconstrained) {
+    return stock_best;
+  }
+  int best_count = 0;
+  double best_v = totalSinkViolation(
+      best.option, best.slack - best.option->slack(), best_count);
+  if (best_count < 2) {
+    return stock_best;  // at most one violating sink: identical to stock
+  }
+  g_evolve_multi_viol++;
+  const double stock_v = best_v;
+  const double best_slack = best.slack.toSeconds();
+  const double epsilon = std::min(1e-12, 0.05 * std::abs(best_slack));
+  size_t choice = stock_best;
+  for (size_t i = 0; i < evaluated.size(); i++) {
+    const RankedOption& cand = evaluated[i];
+    if (i == stock_best || cand.unconstrained
+        || cand.slack.toSeconds() < best_slack - epsilon) {
+      continue;
+    }
+    int count = 0;
+    const double v = totalSinkViolation(
+        cand.option, cand.slack - cand.option->slack(), count);
+    // Strictly lower V wins; ties keep the earlier (stock-ordered) option.
+    if (v < best_v) {
+      best_v = v;
+      choice = i;
+    }
+  }
+  if (choice != stock_best) {
+    g_evolve_root_choice_changed++;
+    if (best_v < stock_v) {
+      g_evolve_tns_reduced++;
+    }
+  }
+  return choice;
+}
