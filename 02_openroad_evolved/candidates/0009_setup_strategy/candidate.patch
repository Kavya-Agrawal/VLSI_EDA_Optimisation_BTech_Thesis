+                 g_shared_rank.changed_first);
+}
+
+void SetupLegacyBase::buildSharedCriticality()
+{
+  shared_criticality_.clear();
+  shared_calls_since_build_ = 0;
+  shared_built_ = true;
+  ++g_shared_rank.builds;
+
+  std::vector<std::pair<sta::Vertex*, float>> viol;
+  for (sta::Vertex* end : sta_->endpoints()) {
+    const float slack = target_collector_->endpointSlack(end);
+    if (slack < config_.setup_slack_margin) {
+      viol.emplace_back(end, slack);
+    }
+  }
+  // Deterministic order: slack, then endpoint name (VertexSet order is by
+  // pointer).
+  std::ranges::sort(viol, [&](const auto& a, const auto& b) {
+    if (a.second != b.second) {
+      return a.second < b.second;
+    }
+    return network_->pathName(a.first->pin())
+           < network_->pathName(b.first->pin());
+  });
+  if (viol.size() > static_cast<size_t>(kSharedMaxViolators)) {
+    viol.resize(kSharedMaxViolators);
+  }
+  if (viol.empty()) {
+    return;
+  }
+  const double worst = std::min<double>(viol.front().second, -1e-30);
+  for (const auto& [end, slack] : viol) {
+    sta::Path* path = target_collector_->findWorstSlackPath(end);
+    if (path == nullptr) {
+      continue;
+    }
+    ++g_shared_rank.paths_expanded;
+    const double weight
+        = std::clamp(static_cast<double>(slack) / worst, 0.0, 1.0);
+    sta::PathExpanded expanded(path, sta_);
+    for (int i = expanded.startIndex(); i < static_cast<int>(expanded.size());
+         i++) {
+      const sta::Path* p = expanded.path(i);
+      sta::Vertex* v = p->vertex(sta_);
+      const sta::Pin* pin = p->pin(sta_);
+      if (v != nullptr && v->isDriver(network_)
+          && !network_->isTopLevelPort(pin)) {
+        shared_criticality_[pin] += weight;
+      }
+    }
+  }
+}
