+bool SetupLegacyPolicy::passAccepted(const EndpointRepairState& endpoint_state,
+                                     const float new_tns,
+                                     const int num_viols)
+{
+  constexpr double kBand = 1.0e-12;  // 1 ps guard band
+  const bool stock = pathImproved(endpoint_state.end_slack,
+                                  endpoint_state.worst_slack,
+                                  endpoint_state.prev_end_slack,
+                                  endpoint_state.prev_worst_slack);
+
+  const double d_end = endpoint_state.end_slack - endpoint_state.prev_end_slack;
+  const double d_wns
+      = endpoint_state.worst_slack - endpoint_state.prev_worst_slack;
+  const double d_tns = static_cast<double>(new_tns)
+                       - static_cast<double>(endpoint_state.prev_pass_tns);
+  const double lambda = std::max(1.0, num_viols / 4.0);
+
+  ++tns_evaluations_;
+
+  bool accept = false;
+  if (d_wns < -kBand || d_end < -kBand) {
+    if (stock) {
+      ++tns_reject_guard_;
+    }
+    return false;
+  }
+  if (stock && -d_tns > 2.0 * std::max(d_end, 0.0) + kBand) {
+    ++tns_reject_veto_;
+    return false;
+  }
+  accept = d_tns + lambda * d_end > 0.0;
+  if (accept && !stock) {
+    ++tns_accept_flips_;
+  } else if (!accept && stock) {
+    ++tns_reject_other_;
+  }
+  return accept;
+}
