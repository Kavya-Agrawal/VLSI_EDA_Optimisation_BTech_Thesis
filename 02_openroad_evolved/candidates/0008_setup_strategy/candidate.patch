+bool SetupLegacyPolicy::repairPath(sta::Path* path,
+                                   const sta::Slack path_slack,
+                                   const bool force_single_repair)
+{
+  if (path == nullptr || repairBudget(path_slack, force_single_repair) == 0) {
+    return false;
+  }
+  if (path->minMax(sta_) != max_) {
+    logger_->error(RSZ,
+                   kMsgRepairSetupExpectedMaxPath,
+                   "repairSetup expects max delay path");
+    return false;
+  }
+
+  // Keep only pin identities across trials. STA paths and prepared generator
+  // inputs must be rebuilt after every journal restore.
+  const sta::Pin* endpoint_pin = path->pin(sta_);
+  std::vector<const sta::Pin*> drivers;
+  for (const Target& target :
+       target_collector_->collectPathDriverTargets(path, path_slack)) {
+    appendUnique(drivers, target.driver_pin);
+  }
+  resizer_.updateParasiticsAndTiming();
+
+  struct Metrics
+  {
+    float wns;
+    float tns;
+    float focus;
+    float hold_wns;
+    float hold_tns;
+  };
+  auto measure = [&]() -> Metrics {
+    sta::Vertex* endpoint = graph_->pinLoadVertex(endpoint_pin);
+    return {std::min(0.0f, sta::delayAsFloat(sta_->worstSlack(max_))),
+            sta::delayAsFloat(sta_->totalNegativeSlack(max_)),
+            endpoint != nullptr
+                ? sta::delayAsFloat(target_collector_->endpointSlack(endpoint))
+                : -sta::INF,
+            sta::delayAsFloat(sta_->worstSlack(sta::MinMax::min())),
+            sta::delayAsFloat(sta_->totalNegativeSlack(sta::MinMax::min()))};
+  };
+  // Check electrical limits on the refreshed graph, including new buffer and
+  // clone pins. Existing generator guards remain in force as well.
+  auto drv_counts = [&]() {
+    std::array<int, 3> counts{};
+    sta::VertexIterator vertices(graph_);
+    while (vertices.hasNext()) {
+      sta::Vertex* vertex = vertices.next();
+      const sta::Pin* pin = vertex->pin();
+      const sta::Scene* scene = nullptr;
+      const sta::RiseFall* rf = nullptr;
+      sta::Slew slew;
+      float limit, slack;
+      sta_->checkSlew(pin,
+                      sta_->scenes(),
+                      max_,
+                      false,
+                      slew,
+                      limit,
+                      slack,
+                      rf,
+                      scene);
+      counts[0] += slack < 0.0f;
+      if (vertex->isDriver(network_)) {
+        float cap;
+        sta_->checkCapacitance(pin,
+                               sta_->scenes(),
+                               max_,
+                               cap,
+                               limit,
+                               slack,
+                               rf,
+                               scene);
+        counts[1] += slack < 0.0f;
+        bool fanout_violation = false;
+        for (const sta::Scene* corner : sta_->scenes()) {
+          float fanout;
+          sta_->checkFanout(pin, corner->mode(), max_, fanout, limit, slack);
+          fanout_violation |= slack < 0.0f;
+        }
+        counts[2] += fanout_violation;
+      }
+    }
+    return counts;
+  };
+  const auto baseline_drvs = drv_counts();
+  const Metrics baseline = measure();
+  size_t endpoint_count = 0;
+  for (sta::Vertex* endpoint : sta_->endpoints()) {
+    const float slack = sta::delayAsFloat(sta_->slack(endpoint, max_));
+    if (std::isfinite(slack) && slack > -sta::INF && slack < sta::INF) {
+      ++endpoint_count;
+    }
+  }
+  const double normalization = std::max(size_t{1}, endpoint_count);
+  auto score = [&](const Metrics& metrics) {
+    // Use strict floors: repeated sub-tolerance regressions must not
+    // accumulate.
+    if (metrics.wns < baseline.wns || metrics.tns < baseline.tns
+        || metrics.focus < baseline.focus
+        || metrics.hold_wns < baseline.hold_wns
+        || metrics.hold_tns < baseline.hold_tns || resizer_.overMaxArea()) {
+      return 0.0;
+    }
+    return (static_cast<double>(metrics.wns) - baseline.wns)
+           + (static_cast<double>(metrics.tns) - baseline.tns) / normalization;
+  };
+
+  struct Choice
+  {
+    const sta::Pin* driver;
+    size_t generator;
+    size_t candidate;
+  };
+  // Regenerate by stable generator/candidate order, never reapply an object
+  // whose apply() or rollback may have consumed its internal state.
+  auto apply = [&](const Choice& choice,
+                   bool keep,
+                   double required_gain,
+                   size_t& count) {
+    sta::Vertex* endpoint = graph_->pinLoadVertex(endpoint_pin);
+    Target target;
+    if (endpoint == nullptr
+        || !makePinTargetOnPath(choice.driver,
+                                endpointWorstPath(endpoint),
+                                baseline.focus,
+                                target)) {
+      count = 0;
+      return 0.0;
+    }
+    MoveGenerator& generator = *move_generators_[choice.generator];
+    if (!generator.isApplicable(target)) {
+      count = 0;
+      return 0.0;
+    }
+    generator.prepareInputs(target);
+    auto candidates = generator.generate(target);
+    count = candidates.size();
+    if (choice.candidate >= count) {
+      return 0.0;
+    }
+    MoveCandidate& candidate = *candidates[choice.candidate];
+    const Estimate estimate = candidate.estimate();
+    if (!estimate.legal) {
+      return 0.0;
+    }
+    committer_.beginJournal();
+    committer_.trackMoveAttempt(target.driver_pin, generator.type());
+    const MoveResult result = committer_.commit(candidate);
+    double gain = 0.0;
+    if (result.accepted) {
+      resizer_.updateParasiticsAndTiming();
+      gain = score(measure());
+      if (gain > 0.0) {
+        const auto drvs = drv_counts();
+        for (size_t index = 0; index < drvs.size(); ++index) {
+          if (drvs[index] > baseline_drvs[index]) {
+            gain = 0.0;
+            break;
+          }
+        }
+      }
+    }
+    if (keep && gain > 0.0 && gain >= required_gain) {
+      // Merge into the endpoint journal; its checkpoint can still undo this.
+      committer_.commitJournal();
+    } else {
+      committer_.restoreJournal();
+      if (keep) {
+        gain = 0.0;
+      }
+    }
+    return gain;
+  };
+
+  std::optional<Choice> winner;
+  double best_gain = 0.0;
+  for (const sta::Pin* driver : drivers) {
+    for (size_t generator = 0; generator < move_generators_.size();
+         ++generator) {
+      size_t count = 1;
+      for (size_t candidate = 0; candidate < count; ++candidate) {
+        const Choice choice{driver, generator, candidate};
+        const double gain = apply(choice, false, 0.0, count);
+        // Equal scores keep the first path/generator/candidate in traversal
+        // order, with no pointer ordering or timing-dependent trial limits.
+        if (gain > best_gain) {
+          best_gain = gain;
+          winner = choice;
+        }
+      }
+    }
+  }
+  size_t count = 0;
+  // One measured winner per pass. Subsequent passes collect a fresh path so
+  // every comparison starts from the same checkpoint, even with a larger
+  // budget.
+  return winner.has_value() && apply(*winner, true, best_gain, count) > 0.0;
+}
