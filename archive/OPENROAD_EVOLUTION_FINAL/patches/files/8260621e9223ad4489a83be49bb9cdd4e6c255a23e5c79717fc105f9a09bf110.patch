--- a/learning_evolution/tools/render_graphs.py
+++ b/learning_evolution/tools/render_graphs.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Optional PNG exports using the system SVG renderer; SVGs remain primary."""
+import argparse
+import ctypes
+import ctypes.util
+from pathlib import Path
+
+
+def render(root):
+    rsvg_name = ctypes.util.find_library('rsvg-2')
+    pixbuf_name = ctypes.util.find_library('gdk_pixbuf-2.0')
+    if not rsvg_name or not pixbuf_name:
+        print('PNG export skipped: system SVG renderer unavailable. SVG graphs remain usable.')
+        return
+    rsvg = ctypes.CDLL(rsvg_name)
+    pixbuf = ctypes.CDLL(pixbuf_name)
+    gobject = ctypes.CDLL(ctypes.util.find_library('gobject-2.0'))
+    rsvg.rsvg_handle_new_from_file.argtypes = [ctypes.c_char_p, ctypes.c_void_p]
+    rsvg.rsvg_handle_new_from_file.restype = ctypes.c_void_p
+    rsvg.rsvg_handle_get_pixbuf.argtypes = [ctypes.c_void_p]
+    rsvg.rsvg_handle_get_pixbuf.restype = ctypes.c_void_p
+    pixbuf.gdk_pixbuf_savev.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_char_p,
+                                       ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p]
+    pixbuf.gdk_pixbuf_savev.restype = ctypes.c_int
+    gobject.g_object_unref.argtypes = [ctypes.c_void_p]
+    count = 0
+    for path in sorted((Path(root) / 'graphs').glob('*.svg')):
+        handle = rsvg.rsvg_handle_new_from_file(str(path).encode(), None)
+        if not handle:
+            raise ValueError('Invalid SVG: ' + str(path))
+        image = rsvg.rsvg_handle_get_pixbuf(handle)
+        if not image:
+            raise ValueError('Unable to rasterize SVG')
+        success = pixbuf.gdk_pixbuf_savev(image, str(path.with_suffix('.png')).encode(), b'png', None, None, None)
+        gobject.g_object_unref(image)
+        gobject.g_object_unref(handle)
+        if not success:
+            raise ValueError('Unable to save PNG')
+        count += 1
+    print(f'Exported {count} PNG graphs')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parents[1])
+    render(parser.parse_args().root)
