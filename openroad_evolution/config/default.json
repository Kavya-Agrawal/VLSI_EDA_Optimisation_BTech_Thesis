  "build_dir": "{workspace}/build",
  "openroad_executable": "{build_dir}/bin/openroad",
  "jobs": 4,
  "build_command": "cd {source_dir} && ./etc/Build.sh -cmake-build -dir={build_dir} -threads={jobs}",
  "unit_test_command": "ctest --test-dir {build_dir} --output-on-failure -R '^dpl\\.(mirror1|mirror2|mirror3|mirror_edge_spacing)\\.(py|tcl)$'",
  "flow_command": "make -C {orfs_root}/flow DESIGN_CONFIG={design_config} FLOW_VARIANT=evolve_{candidate_id}_r{replica} clean_all && GPL_RANDOM_SEED={flow_seed} GRT_SEED={flow_seed} OR_SEED={flow_seed} OPENROAD_EXE={openroad_executable} make -C {orfs_root}/flow DESIGN_CONFIG={design_config} FLOW_VARIANT=evolve_{candidate_id}_r{replica} RULES_JSON={rules_json} all metadata",
  "metrics_path": "{orfs_root}/flow/reports/{platform}/{design_name}/evolve_{candidate_id}_r{replica}/metadata.json",
  "full_flow": true,
  "design_config": "designs/nangate45/gcd/config.mk",
  "rules_json": "designs/nangate45/gcd/rules-base.json",
  "platform": "nangate45",
  "design_name": "gcd",
  "flow_seeds": [101, 211, 307, 401, 503],
  "bootstrap_samples": 2000,
  "promotion_min_score": 0.002,
  "timing_absolute_tolerance": 0.0,
  "max_relative_wirelength_regression": 0.005,
  "max_relative_runtime_regression": 0.10,
  "seed": 41
}
